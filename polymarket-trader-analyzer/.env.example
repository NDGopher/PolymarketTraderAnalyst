# Kalshi credentials (copy from your other project)
KALSHI_KEY_ID=your-api-key-id-here

# Paste your full PEM key in quotes (multi-line OK)
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
paste-your-key-here
-----END RSA PRIVATE KEY-----"

# Or point to a .pem file instead of inline key:
# KALSHI_PRIVATE_KEY_PATH=C:\path\to\kalshi.pem

# Markets to track (comma-separated Kalshi tickers for this game)
LAB_TICKERS=TICKER_O35,TICKER_O45

# Label for this session (shows in output folder name)
LAB_GAME=Parma-Cremonese

# Optional: use Kalshi demo environment
# KALSHI_DEMO=false
