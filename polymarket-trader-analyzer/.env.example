# Kalshi credentials (needed for WebSocket; REST paper tape works without)
KALSHI_KEY_ID=your-api-key-id-here

# Paste your full PEM key in quotes (multi-line OK)
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
paste-your-key-here
-----END RSA PRIVATE KEY-----"

# Or point to a .pem file instead of inline key:
# KALSHI_PRIVATE_KEY_PATH=C:\path\to\kalshi.pem

# Do NOT pin LAB_TICKERS / LAB_GAME. Stale leftovers (yesterday's Melgar/Grau)
# are ignored. Launch with no --tickers; auto-discover funds live soccer.
# LAB_TICKERS=
# LAB_GAME=

# Paper scalp on book-detected GOAL (never live)
LAB_TRADER_ENABLED=1
LAB_TRADER_CONTRACTS=50
LAB_TRADER_BID_OFFSET_CENTS=1
